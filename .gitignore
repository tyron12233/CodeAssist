# Gradle — ignore the module-level output dirs only, NOT source packages named `build`
# (e.g. dev/ide/build/ in build-api/build-engine). `**/build/` would wrongly exclude that source.
.gradle/
.kotlin/
/build/
/*/build/
/*/*/build/
!gradle/wrapper/gradle-wrapper.jar

# IDE-derived / OS
*.log
*.trace
.DS_Store
.idea/
.kotlin/

# Android (machine-local SDK path)
local.properties

# Release signing — never commit
keystore/
keystore.properties

# Local agent secrets — never commit
agent.properties

# The daily-challenge judge: a separate Vercel service, with deployment config tied to an account.
# Kept out of the public repo for the same reason supabase/ is.
judge/

# Internal / agent working files — not part of the public project
.claude/
CLAUDE.md
RELEASE_NOTES.md

# Internal design docs and scratch material (public docs live in docs/, tracked explicitly below)
docs/architecture-core-foundation.md
docs/completion-and-incremental-ast.md
docs/analysis-api.md
docs/android-support.md
docs/block-based-editing.md
docs/completion-regression-benchmarks.md
docs/indexing-infrastructure.md
docs/jdt-name-environment.md
docs/kotlin-compiler-on-art.md
docs/kotlin-completion-backend.md
docs/xml-language-support.md
docs/codeassist-layout-preview-design.md
docs/handoff_onboarding_compose/
docs/design/
docs/*.png

# Release staging area. Built APKs/AABs and the announcement drafts that ship with them belong in
# `dist/`, not at the repo root -- one release leaves four files behind and they accumulate. Nothing
# in the build reads this directory; it is a place to put things, kept out of git entirely.
dist/

# Built app artifacts (never commit; releases attach these, Play gets the AAB). Still ignored
# wherever they land, so a stray root-level build output cannot be committed by accident.
*.aab
*.apk

# Release announcement drafts (never commit; they feed `gh release create` from the working tree only)
discord_release_*.txt

# Supabase backend for the Projects Store (untracked: migrations, keys, admin page)
supabase/

# Firebase config for the launcher (push notifications). Untracked by default: it carries a Firebase API
# key, and this repo is public. The key is package- and signature-restricted by Google and cannot SEND a
# push (that needs the service account, which lives in a Supabase secret), so committing it is defensible —
# but it is a decision to make deliberately rather than by accident, and it cannot be un-published once it
# is in the history. Builds without it simply have push disabled.
app/ide-android/google-services.json

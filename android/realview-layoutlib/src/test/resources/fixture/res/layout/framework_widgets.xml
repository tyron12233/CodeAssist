<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp" android:background="#FFF7F2FA">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/title" android:textSize="28sp" android:textColor="@color/ink" android:textStyle="bold"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:text="Rendered by the real android.widget classes, on a JVM." android:textSize="16sp"/>
    <EditText android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
        android:hint="An EditText" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal">
        <Button android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Button"/>
        <CheckBox android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:checked="true" android:text="CheckBox"/>
        <Switch android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:checked="true"/>
    </LinearLayout>
    <SeekBar android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:progress="60"/>
    <ProgressBar style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:progress="40"/>
    <RatingBar android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:rating="3.5"/>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- The system splash icon (API 31+): the launcher logo on the splash colour, so the icon has no visible plate. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/splash_background" />
    <foreground android:drawable="@drawable/splash_logo" />
</adaptive-icon>

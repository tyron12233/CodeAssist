<?xml version="1.0" encoding="utf-8"?>
<!-- The Halloween launcher icon (Settings > Appearance > App icon). No monochrome layer: a themed-icon
     silhouette would lose the carved face, and without one the launcher shows this icon as it is. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_pumpkin_background" />
    <foreground android:drawable="@drawable/ic_launcher_pumpkin_foreground" />
</adaptive-icon>

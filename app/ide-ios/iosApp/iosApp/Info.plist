<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<!-- The app's own URL scheme. `codeassist://store/<id>` opens a project's page in the store (the
	     moderation page uses it to jump from a submission into the app), and `codeassist://auth-callback`
	     is where a sign-in provider sends the user back. The same scheme the Android manifest registers. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>dev.ide.codeassist.ios</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>codeassist</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>1</string>
	<!-- Compose Multiplatform refuses to start without this: without it iOS caps the app at 60Hz on a
	     ProMotion display, so the IDE would scroll and type at half the device's refresh rate. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Projects live in the app's Documents container (an iOS app cannot open an arbitrary folder), and
	     these two keys are the only thing that makes that directory reachable from outside the app: the
	     Files app and Finder file sharing list it, so a project made on the phone can be copied to a Mac and
	     a folder of sources can be dropped in. Without them the container is private, and with no zip writer
	     and no Git on this host there is no other way in or out. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<!-- `arm64`, not the template's `armv7`: the framework is linked for arm64 only, so declaring a 32-bit
	     requirement described a build that does not exist. -->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>

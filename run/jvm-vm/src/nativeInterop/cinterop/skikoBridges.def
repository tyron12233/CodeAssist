/** The bridge called [name], or NULL. The table is sorted, so this is a binary search. */
static inline void* skikoBridgeLookup(const char* name) {
    int lo = 0, hi = 1021 - 1;
    while (lo <= hi) {
        int mid = (lo + hi) / 2;
        int c = strcmp(skikoBridges[mid].name, name);
        if (c == 0) return skikoBridges[mid].fn;
        if (c < 0) lo = mid + 1; else hi = mid - 1;
    }
    return 0;
}

static inline int skikoBridgeCount(void) { return 1021; }
